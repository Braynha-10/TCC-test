<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title>Acesso não autorizado</title>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel="stylesheet" href="/public/login.css">
</head>
<body>
    <main class="access-error" role="alert">
        <div class="status-icon" aria-hidden="true">!</div>
        <p class="status-code"><%= typeof statusCode !== 'undefined' ? statusCode : 401 %></p>
        <h1>Acesso não autorizado</h1>
        <p><%= typeof message !== 'undefined' ? message : 'Você precisa entrar para acessar esta página.' %></p>
        <a class="botao" href="<%= typeof loginPath !== 'undefined' ? loginPath : '/login' %>">Ir para o login</a>
    </main>
</body>
</html>