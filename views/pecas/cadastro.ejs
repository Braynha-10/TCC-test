<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Peças - Gerente</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/public/forms.css">
</head>
<body>

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="container col-11 col-sm-8 col-md-6 col-lg-5">

        <h2 class="text-center mb-4">
            <%= peca ? 'Editar Peça' : 'Cadastrar Peça' %>
        </h2>

        <form 
            action="<%= peca ? `/gerente/pecas/modifica/${peca.id}?_method=PATCH` : '/gerente/pecas/cadastro' %>" 
            method="POST"
        >

            <input type="hidden" name="_method" value="<%= peca ? 'PATCH' : 'POST' %>">

            <!-- Nome -->
            <div class="mb-3">
                <label>Nome</label>
                <input type="text" name="nome" class="form-control"
                       value="<%= peca ? peca.nome : '' %>" required>
            </div>

            <!-- Descrição -->
            <div class="mb-3">
                <label>Descrição</label>
                <input type="text" name="descricao" class="form-control"
                       value="<%= peca ? peca.descricao : '' %>" required>
            </div>

            <!-- Preço -->
            <div class="mb-3">
                <label>Preço</label>
                <input type="number" step="0.01" name="preco" class="form-control"
                       value="<%= peca ? peca.preco : '' %>" required>
            </div>

            <% if (!peca) { %>
                <!-- Quantidade inicial -->
                <div class="mb-3">
                    <label>Quantidade inicial em estoque</label>
                    <input type="number" name="quantidade" class="form-control" required>
                </div>

                <!-- Capacidade -->
                <div class="mb-3">
                    <label>Capacidade máxima do estoque</label>
                    <input type="number" name="capacidade" class="form-control" required>
                </div>
            <% } %>

            <button type="submit" class="btn btn-primary w-100">
                <%= peca ? 'Salvar Alterações' : 'Cadastrar Peça' %>
            </button>

            <br><br>
            <a href="/gerente/painelGerente" class="btn btn-danger w-100">Voltar</a>

        </form>
    </div>
</div>

</body>
</html>
