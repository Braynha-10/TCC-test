<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Solicitações de Peças</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/listagens.css">
</head>

<body>
<%- include('../partials/alert') %>
<div class="container col-12 col-sm-11 col-md-10 py-4">

  <div class="d-flex justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">Lista de Solicitações de Peças</h1>
    <% if (mecanico) { %>
      <a href="/mecanico/peca" class="btn btn-success">+ Nova solicitação</a>
    <% } %>
  </div>

  <!-- BUSCA -->
  <form method="GET" class="d-flex mb-3">
    <input
      type="text"
      name="search"
      class="form-control"
      placeholder="Buscar peça..."
      value="<%= search %>"
    >
    <button class="btn btn-primary ms-2">Buscar</button>
  </form>

  <!-- TABELA -->
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
      <tr>
        <th>Mecânico</th>
        <th>Peça</th>
        <th>Descrição</th>
        <th>Preço</th>
        <th>Qtd Solicitada</th>
        <th>Status</th>
        <% if (gerente) { %><th class="text-center">Ações</th><% } %>
      </tr>
      </thead>

      <tbody>
      <% if (pecas && pecas.length) { %>
        <% pecas.forEach(p => { %>
          <tr>
            <td><%= p.Mecanico ? p.Mecanico.nome : '-' %></td>
            <td><%= p.nome %></td>
            <td><%= p.descricao %></td>
            <td>
              <% if (p.preco != null) { %>
                R$ <%= Number(p.preco).toFixed(2) %>
              <% } else { %> - <% } %>
            </td>
            <td><%= p.quantidade %></td>

            <td>
              <% if (p.status === 'APROVADO') { %>
                <span class="badge bg-success">APROVADO</span>
              <% } else if (p.status === 'RECUSADO') { %>
                <span class="badge bg-danger">RECUSADO</span>
              <% } else { %>
                <span class="badge bg-secondary">PENDENTE</span>
              <% } %>
            </td>

            <% if (gerente) { %>
              <td class="text-center">

                <% if (p.status === 'PENDENTE') { %>

                  <!-- BOTÃO ABRE MODAL -->
                  <button
                    type="button"
                    class="btn btn-sm btn-success mb-1"
                    onclick="abrirModal(<%= p.id %>, <%= p.quantidade %>)">
                    Aprovar
                  </button>

                  <!-- RECUSAR -->
                  <form action="/gerente/pecas/solicitacoes" method="POST" class="d-inline">
                    <input type="hidden" name="solicitacaoId" value="<%= p.id %>">
                    <input type="hidden" name="status" value="RECUSADO">
                    <button type="submit" class="btn btn-sm btn-danger mb-1">
                      Recusar
                    </button>
                  </form>

                <% } else { %>
                  -
                <% } %>

              </td>
            <% } %>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="<%= gerente ? 7 : 6 %>" class="text-center">
            Nenhuma solicitação encontrada.
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>

  <!-- PAGINAÇÃO -->
  <nav class="d-flex justify-content-center">
    <ul class="pagination">

      <% if (currentPage > 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= search %>">Anterior</a>
        </li>
      <% } %>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
        </li>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= search %>">Próximo</a>
        </li>
      <% } %>

    </ul>
  </nav>

  <br><br>
    <div class="d-flex justify-content-center">
        <% if (typeof mecanico !== 'undefined' && mecanico) { %>
            <a href="/mecanico/painelMecanico" class="btn btn-danger">Voltar</a>
        <% } else { %>
            <a href="/gerente/painelGerente" class="btn btn-danger">Voltar</a>
        <% } %>
    </div>
</div>

<!-- ================= MODAL ================= -->
<div class="modal fade" id="modalAprovacao" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/gerente/pecas/solicitacoes" class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Aprovar Solicitação</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <input type="hidden" name="solicitacaoId" id="modalSolicitacaoId">
        <input type="hidden" name="status" value="APROVADO">

        <div class="mb-3">
          <label class="form-label">Quantidade a adicionar no estoque</label>
          <input type="number" min="1" class="form-control" name="quantidade" id="modalQuantidade" required>
        </div>

      </div>

      <div class="modal-footer">
        <button type="submit" class="btn btn-success">Confirmar Aprovação</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      </div>

    </form>
  </div>
</div>

<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  function abrirModal(id, quantidade) {
    document.getElementById('modalSolicitacaoId').value = id;
    document.getElementById('modalQuantidade').value = quantidade;

    const modal = new bootstrap.Modal(document.getElementById('modalAprovacao'));
    modal.show();
  }
</script>

</body>
</html>
